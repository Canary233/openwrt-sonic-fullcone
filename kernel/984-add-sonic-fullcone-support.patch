+static DEFINE_MUTEX(nf_nat_fullcone_mutex);
+
+/* Add an already existing SNAT mapping to the 3-tuple index. */
+static int nf_nat_fullcone_backfill(struct nf_conn *ct, void *data)
+{
+	struct nf_conn_nat *nat = nfct_nat(ct);
+	struct nf_conntrack_tuple new_tuple;
+	unsigned int h;
+
+	if (!(ct->status & IPS_SRC_NAT_DONE) || nf_ct_is_dying(ct))
+		return 0;
+
+	/* Plain nft snat conntracks may predate the index and have no NAT
+	 * extension; they cannot be linked anymore (ct is confirmed).
+	 */
+	if (!nat || nat->fullcone_linked)
+		return 0;
+
+	nf_ct_invert_tuple(&new_tuple, &ct->tuplehash[IP_CT_DIR_REPLY].tuple);
+	h = hash_by_src(nf_ct_net(ct), nf_ct_zone(ct), &new_tuple);
+
+	nat->ct = ct;
+	spin_lock_bh(&nf_nat_locks[h % CONNTRACK_LOCKS]);
+	if (!nat->fullcone_linked) {
+		hlist_add_head_rcu(&nat->nat_by_manip_src,
+				   &nf_nat_by_manip_src[h]);
+		nat->fullcone_linked = true;
+	}
+	spin_unlock_bh(&nf_nat_locks[h % CONNTRACK_LOCKS]);
+
+	return 0;
+}
+
+/* Called when the first fullcone rule is installed.  The index is only
+ * needed when fullcone is in use, so it is allocated lazily to keep the
+ * default (fullcone disabled) configuration free of the extra table.
+ */
+int nf_nat_fullcone_enable(struct net *net)
+{
+	struct nat_net *nat_net = net_generic(net, nat_net_id);
+	int err = 0;
+
+	mutex_lock(&nf_nat_fullcone_mutex);
+
+	if (!smp_load_acquire(&nf_nat_by_manip_src)) {
+		struct hlist_head *table;
+
+		table = nf_ct_alloc_hashtable(&nf_nat_htable_size, 0);
+		if (!table) {
+			err = -ENOMEM;
+			goto out;
+		}
+		smp_store_release(&nf_nat_by_manip_src, table);
+	}
+
+	if (!nat_net->fullcone_backfilled) {
+		struct nf_ct_iter_data iter_data = {
+			.net = net,
+		};
+
+		nf_ct_iterate_cleanup_net(nf_nat_fullcone_backfill, &iter_data);
+		nat_net->fullcone_backfilled = true;
+	}
+
+out:
+	mutex_unlock(&nf_nat_fullcone_mutex);
+	return err;
+}
+EXPORT_SYMBOL_GPL(nf_nat_fullcone_enable);
+
+static inline int
+same_reply_dst(const struct nf_conn *ct,
+	       const struct nf_conntrack_tuple *tuple)
+{
+	const struct nf_conntrack_tuple *t;
+
+	t = &ct->tuplehash[IP_CT_DIR_REPLY].tuple;
+	return (t->dst.protonum == tuple->dst.protonum &&
+		nf_inet_addr_cmp(&t->dst.u3, &tuple->dst.u3) &&
+		t->dst.u.all == tuple->dst.u.all);
+}
+
+/* Does the conntrack's translated source match the candidate tuple's src? */
+static inline bool
+same_manip_src(const struct nf_conn *ct,
+	       const struct nf_conntrack_tuple *tuple)
+{
+	const struct nf_conntrack_tuple *t;
+
+	t = &ct->tuplehash[IP_CT_DIR_REPLY].tuple;
+	return (t->dst.protonum == tuple->dst.protonum &&
+		nf_inet_addr_cmp(&t->dst.u3, &tuple->src.u3) &&
+		t->dst.u.all == tuple->src.u.all);
+}
+
+/* Is this 3-tuple already taken? (not by us) */
+static int
+nf_nat_used_3_tuple(const struct nf_conntrack_tuple *tuple,
+		    const struct nf_conn *ignored_conntrack,
+		    enum nf_nat_manip_type maniptype)
+{
+	struct nf_conn_nat *nat;
+	const struct nf_conn *ct;
+	const struct nf_conntrack_zone *zone;
+	unsigned int h;
+	struct net *net = nf_ct_net(ignored_conntrack);
+
+	/* 3-tuple uniqueness is required for translated source only */
+	if (maniptype != NF_NAT_MANIP_SRC)
+		return 0;
+
+	if (!smp_load_acquire(&nf_nat_by_manip_src))
+		return 0;
+
+	zone = nf_ct_zone(ignored_conntrack);
+
+	h = hash_by_src(net, zone, tuple);
+	hlist_for_each_entry_rcu(nat, &nf_nat_by_manip_src[h], nat_by_manip_src) {
+		ct = nat->ct;
+		if (net_eq(net, nf_ct_net(ct)) &&
+		    nf_ct_zone_equal(ct, zone, IP_CT_DIR_ORIGINAL) &&
+		    same_manip_src(ct, tuple))
+			return 1;
+	}
+	return 0;
+}
