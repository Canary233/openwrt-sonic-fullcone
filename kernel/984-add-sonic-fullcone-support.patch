+/* Link the conntrack into the translated-source index, allocating the NAT
+ * extension if needed.  Returns true if the conntrack ended up linked.
+ * The caller must not be holding nf_nat_locks.
+ */
+static bool nf_nat_fullcone_link(struct nf_conn *ct,
+				 const struct nf_conntrack_tuple *new_tuple)
+{
+	struct nf_conn_nat *nat;
+	unsigned int h;
+
+	if (!smp_load_acquire(&nf_nat_by_manip_src))
+		return false;
+
+	nat = nfct_nat(ct);
+	if (!nat)
+		nat = nf_ct_nat_ext_add(ct);
+	if (!nat)
+		return false;
+
+	h = hash_by_src(nf_ct_net(ct), nf_ct_zone(ct), new_tuple);
+	nat->ct = ct;
+	spin_lock_bh(&nf_nat_locks[h % CONNTRACK_LOCKS]);
+	if (!nat->fullcone_linked) {
+		hlist_add_head_rcu(&nat->nat_by_manip_src,
+				   &nf_nat_by_manip_src[h]);
+		nat->fullcone_linked = true;
+	}
+	spin_unlock_bh(&nf_nat_locks[h % CONNTRACK_LOCKS]);
+
+	return true;
+}
